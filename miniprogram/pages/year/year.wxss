.subheading { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.stat-row { display: flex; gap: 40rpx; margin-bottom: 20rpx; }
.stat-num { font-size: 40rpx; font-weight: 700; color: var(--accent); }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.tile {
  width: 84rpx; height: 84rpx; line-height: 84rpx; text-align: center;
  border-radius: 18rpx; background: #fff; box-shadow: 0 2rpx 8rpx rgba(28,35,51,.08);
  font-weight: 600;
}
.tile.right { background: #e7f8ee; color: var(--ok); }
.tile.wrong { background: #fdecec; color: var(--bad); }
.tile.viewed { background: var(--accent-soft); color: var(--accent); }
.legend { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; margin-bottom: 24rpx; }
.dot { display: inline-block; width: 18rpx; height: 18rpx; border-radius: 50%; margin-left: 12rpx; }
.dot.todo { background: #d1d5db; }
.dot.right { background: var(--ok); }
.dot.wrong { background: var(--bad); }
.dot.viewed { background: var(--accent); }
.clear { width: 100%; color: var(--bad); }
.error { color: var(--bad); }
