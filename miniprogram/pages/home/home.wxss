.brand { padding: 12rpx 8rpx 28rpx; }
.brand-title { font-size: 44rpx; font-weight: 700; }
.subheading { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.stat-row { display: flex; gap: 40rpx; margin-bottom: 20rpx; }
.stat-num { font-size: 40rpx; font-weight: 700; color: var(--accent); }
.year-head { display: flex; justify-content: space-between; align-items: baseline; }
.year-num { font-size: 36rpx; font-weight: 700; }
.subjects { margin: 12rpx 0; }
.year-card:active { transform: scale(.99); }
.error { color: var(--bad); }
.footer { text-align: center; padding: 20rpx; }
